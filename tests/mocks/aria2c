#!/usr/bin/env bun
// tests/mocks/aria2c — a fake aria2c for offline integration tests.
//
// yt-dlp invokes it as an external downloader:
//   aria2c --no-conf -x16 -s16 -j16 -k 1M --min-split-size 1M \
//          --file-allocation=none --remove-control-file=true \
//          [--max-overall-download-limit 1024K] --out <tmpfilename> <url>
//
// The mock answers --version (so the engine's dependency probe accepts it) and
// reproduces the real binary's control-file lifecycle — which is what makes
// aria2c resume work, and what makes a stranded control file dangerous:
//
//   • an interrupted download leaves `<out>` PLUS `<out>.aria2`
//   • a later run sees the control file and RESUMES instead of restarting
//   • on success the control file is removed
//   • a control file whose data file is gone is a hard error: with
//     --allow-overwrite=false (aria2c's default) the real binary neither
//     resumes nor restarts. This is the state the engine must never create.
//
// It records the argv it received to "<out>.aria2-args" so tests can assert the
// multi-connection settings and the bandwidth cap actually reached the
// downloader, plus whether the run resumed.
//
// Failure injection (independent of the yt-dlp mock's own FAKE_FAIL_TIMES, so a
// failure can originate inside the external downloader):
//   FAKE_ARIA2C_FAIL_TIMES=2   fail the first N attempts
//   FAKE_ARIA2C_FAIL_MODE=transient|corrupt   what the failure looks like
//   FAKE_ARIA2C_INFLIGHT_MS=3000   hold a transfer open (partial + control file
//                                  on disk) so a hard kill can interrupt it

const argv = process.argv.slice(2);

if (argv.includes("--version")) {
  console.log("1.37.0-mock");
  process.exit(0);
}

function flagValue(name: string): string | null {
  const i = argv.indexOf(name);
  return i >= 0 && i + 1 < argv.length ? argv[i + 1] : null;
}

// The real aria2c validates option values and dies with exit 28 ("bad/
// unrecognized option was given or unexpected option argument was given"),
// printing the offending option's help block first. -x is hard-capped at 16
// and -k/--min-split-size must be a size like 512K/1M — reproduce both so the
// engine's clamping and its BAD_DOWNLOADER_ARGS pause path are testable.
function rejectOption(help: string): never {
  console.error(help);
  process.exit(28);
}
const xArg = flagValue("-x");
if (xArg !== null) {
  const x = parseInt(xArg, 10);
  if (!Number.isFinite(x) || x < 1 || x > 16) {
    rejectOption(
      `-x, --max-connection-per-server=N\n` +
        `    Set the maximum number of connections to one server for each download.\n` +
        `    Possible Values: 1-16\n    Default: 1\n    Tags: #basic, #http, #ftp`,
    );
  }
}
const splitArg = flagValue("--min-split-size") ?? flagValue("-k");
if (splitArg !== null && !/^\d+(\.\d+)?[KMG]$/i.test(splitArg)) {
  rejectOption(
    `-k, --min-split-size=SIZE\n` +
      `    Split a download to this size or larger.\n` +
      `    Possible Values: 1M-1G\n    Default: 20M\n    Tags: #basic, #http`,
  );
}

const out = flagValue("--out") ?? flagValue("-o");

if (!out) {
  console.error("aria2c mock: no --out given");
  process.exit(1);
}

// aria2c's control file: "the filename of downloading file with .aria2 appended".
const controlFile = `${out}.aria2`;

const failTimes = parseInt(process.env.FAKE_ARIA2C_FAIL_TIMES || "0", 10);
const inflightMs = parseInt(process.env.FAKE_ARIA2C_INFLIGHT_MS || "0", 10);
const failMode = process.env.FAKE_ARIA2C_FAIL_MODE || "transient";
const counterFile = `${out}.aria2-attempts`;
let attempts = 0;
try {
  attempts = parseInt(await Bun.file(counterFile).text(), 10) || 0;
} catch {}
attempts += 1;
await Bun.write(counterFile, String(attempts));

const controlExists = await Bun.file(controlFile).exists();

// A control file for a transfer whose data is gone. The real aria2c cannot
// resume (nothing to resume from) and, with --allow-overwrite=false, will not
// start over either — it just fails, forever. Fail loudly so a test catches the
// engine creating this state by deleting a .part without its control file.
if (controlExists && !(await Bun.file(out).exists())) {
  console.error(
    "ERROR: unable to resume download, incomplete or corrupt data — control file exists but the " +
      "data file is gone, and --allow-overwrite=false means aria2c cannot restart",
  );
  process.exit(3);
}

const resuming = controlExists;

// Simulate a genuinely in-flight transfer: the partial and its control file
// exist while bytes are still arriving, which is the state a hard kill leaves
// behind. The parent is watched so that when yt-dlp dies the transfer is
// abandoned rather than completed by an orphan.
if (inflightMs > 0) {
  await Bun.write(out, "x".repeat(4096));
  await Bun.write(controlFile, "mock-control-file");
  const parentPid = process.ppid;
  const deadline = Date.now() + inflightMs;
  let orphaned = false;
  while (Date.now() < deadline) {
    if (process.ppid !== parentPid) {
      orphaned = true;
      break;
    }
    await Bun.sleep(25);
  }
  if (orphaned) {
    console.error("aria2c mock: parent went away — abandoning the transfer");
    process.exit(3);
  }
}

if (failTimes > 0 && attempts <= failTimes) {
  // Interrupted transfer: leave BOTH the partial data and the control file,
  // exactly like a real interruption, so the next run can resume.
  await Bun.write(out, "x".repeat(4096));
  await Bun.write(controlFile, "mock-control-file");
  if (failMode === "corrupt") {
    console.error("ERROR: unable to resume download, incomplete or corrupt data");
  } else {
    console.error("ERROR: Unable to download webpage: connection reset by peer (aria2c mock failure)");
  }
  console.error(`aria2c mock: simulated failure (attempt ${attempts})`);
  process.exit(3);
}

// Record what yt-dlp actually asked for. This file is durable evidence for the
// integration test, so it is intentionally NOT cleaned up on success. It also
// carries whether this run resumed, proving --continue reached the downloader.
await Bun.write(`${out}.aria2-args`, `${argv.join(" ")}\nresumed=${resuming ? "yes" : "no"}`);
await Bun.write(out, "fake-aria2c-payload");

// A completed download removes its control file (yt-dlp passes
// --remove-control-file=true, and aria2c does this by default anyway).
try {
  await Bun.file(controlFile).unlink();
} catch {}
try {
  await Bun.file(counterFile).unlink();
} catch {}
console.log(`aria2c mock: wrote ${out}${resuming ? " (resumed)" : ""}`);
process.exit(0);
